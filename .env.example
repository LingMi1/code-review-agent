# ── code-review-agent (Go 服务) 读取的变量 ──
GITHUB_TOKEN=your_github_personal_access_token_here
WEBHOOK_SECRET=your_webhook_secret_here

# 手动触发 API 的访问令牌（留空则允许未鉴权触发，仅限本地开发）
API_TOKEN=your_api_token_here

# 允许审查的仓库 owner 白名单（逗号分隔，大小写不敏感）。留空 = 不限制（仅本地开发）。
ALLOWED_OWNERS=LingMi1

# agent-go 认知面 gRPC 地址（docker compose 下为 cognition:50051，本地直连为 localhost:50051）
COGNITION_ADDR=localhost:50051
# HTTP 监听地址
LISTEN_ADDR=:8080
# SQLite 数据库文件路径
SQLITE_PATH=./data/reviews.db
# CORS 允许的前端 origin（逗号分隔）
ALLOWED_ORIGINS=http://localhost:5173

# 是否信任 X-Forwarded-For 头做 IP 限流（仅在部署于受信反向代理后置 true，防伪造绕过限流）
TRUST_X_FORWARDED_FOR=false

# OpenTelemetry（可选；留空则只本地采样不导出）
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
# OTEL_SERVICE_NAME=code-review-agent

# ── agent-go 认知面 (cognition 容器) 读取的变量 ──
# 以下三项本 Go 服务不读取，由 docker compose 注入 agent-go 容器。
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
